VITE_CONVEX_URL=https://your-deployment.convex.cloud
# Required for Chromium-native auth refresh
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-key
# Optional but recommended: Chrome Web Store public key for a stable New Tab extension ID during development.
# CRX_PUBLIC_KEY_NEWTAB=MIIBIjANBgkqh...
# Optional: app origin used for connection flow and Clerk sync cookies
# VITE_APP_URL=https://brutebookmarks.com
# Optional: development switch for the new-tab fallback.
# Set to true to force the native fallback without redirecting to the hosted app.
# VITE_FORCE_NTP_FALLBACK=false
# Optional: explicit Clerk Frontend API host if you do not want to derive it from the publishable key
# VITE_CLERK_FRONTEND_API=https://your-instance.clerk.accounts.dev
# Optional in development. Production is tracked in .env.production.
# The production Sync Host is the Clerk Frontend API domain, not the app origin.
# VITE_CLERK_SYNC_HOST=https://clerk.brutebookmarks.com
