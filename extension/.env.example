VITE_CONVEX_URL=https://your-deployment.convex.cloud
# Required for Chromium-native auth refresh
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-key
# Optional but recommended: Chrome Web Store public key for a stable quick-save extension ID during development
# CRX_PUBLIC_KEY=MIIBIjANBgkqh...
# Optional: separate Chrome Web Store public key for the new-tab extension.
# Do not reuse CRX_PUBLIC_KEY here; Chrome treats same-key builds as the same extension.
# CRX_PUBLIC_KEY_NEWTAB=MIIBIjANBgkqh...
# Optional: app origin used for connection flow and Clerk sync cookies
# VITE_APP_URL=https://brutebookmarks.com
# Optional: explicit Clerk Frontend API host if you do not want to derive it from the publishable key
# VITE_CLERK_FRONTEND_API=https://your-instance.clerk.accounts.dev
# Optional: Sync Host for shared auth with the web app; defaults to VITE_APP_URL / https://brutebookmarks.com
# VITE_CLERK_SYNC_HOST=https://brutebookmarks.com
