VITE_CONVEX_URL=https://your-deployment.convex.cloud
# Required for Chromium-native auth refresh
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-key
# Optional: explicit Clerk Frontend API host if you do not want to derive it from the publishable key
# VITE_CLERK_FRONTEND_API=https://your-instance.clerk.accounts.dev
# Optional: Sync Host for shared auth with the web app; defaults to the Clerk frontend host when omitted
# VITE_CLERK_SYNC_HOST=https://your-instance.clerk.accounts.dev
