{
  "name": "brute-bookmarks-extension",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/wxt-variant.mjs quick-save",
    "dev:firefox": "node ./scripts/wxt-variant.mjs quick-save --browser firefox",
    "dev:newtab": "node ./scripts/wxt-variant.mjs newtab",
    "dev:newtab:firefox": "node ./scripts/wxt-variant.mjs newtab --browser firefox",
    "build": "node ./scripts/wxt-variant.mjs quick-save build",
    "build:firefox": "node ./scripts/wxt-variant.mjs quick-save build --browser firefox",
    "build:newtab": "node ./scripts/wxt-variant.mjs newtab build",
    "build:newtab:firefox": "node ./scripts/wxt-variant.mjs newtab build --browser firefox",
    "zip": "node ./scripts/wxt-variant.mjs quick-save zip",
    "zip:firefox": "node ./scripts/wxt-variant.mjs quick-save zip --browser firefox",
    "zip:newtab": "node ./scripts/wxt-variant.mjs newtab zip",
    "zip:newtab:firefox": "node ./scripts/wxt-variant.mjs newtab zip --browser firefox"
  },
  "dependencies": {
    "@clerk/chrome-extension": "^3.1.14",
    "convex": "^1.31.7"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wxt": "^0.20.7"
  }
}
